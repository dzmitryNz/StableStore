# .gitignore

# Персональные файлы
personal/
private/
*.personal.md

# Инвентарные файлы с реальными данными
inventory/*.xlsx
inventory/*.csv
my-inventory.md

# Временные файлы
*.tmp
*.bak
*.swp
*~

# OS файлы
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.sublime-*

# Obsidian
.obsidian/

# Логи
*.log

# Локальные заметки
notes/local/
scratch/
